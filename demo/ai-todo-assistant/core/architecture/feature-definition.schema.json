{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifa.dev/schemas/feature-definition.schema.json",
  "title": "AIFA Feature Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "boundedContext", "businessNeed", "dependsOn", "consumesContracts", "backend", "frontend", "contracts", "events", "security", "workItems"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
    "boundedContext": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
    "businessNeed": { "type": "string", "minLength": 20 },
    "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" } },
    "consumesContracts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z-]+/contracts/v[0-9]+/.+\\.schema\\.json$" } },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "method", "capabilities", "mcp"],
      "properties": {
        "route": { "type": "string", "pattern": "^/api/" },
        "method": { "enum": ["GET", "POST", "PATCH", "DELETE"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exposed"],
          "properties": { "exposed": { "type": "boolean" }, "toolName": { "type": "string" } }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": { "slots": { "type": "array", "items": { "type": "string" } } }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string", "pattern": "^contracts/.+\\.schema\\.json$" },
        "output": { "type": "string", "pattern": "^contracts/.+\\.schema\\.json$" },
        "mcpInput": { "type": "string", "pattern": "^contracts/.+\\.schema\\.json$" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation", "actorRequired", "idempotent", "requiresConfirmation", "mcpScopes", "concurrency"],
      "properties": {
        "mutation": { "type": "boolean" },
        "actorRequired": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "requiresConfirmation": { "type": "boolean" },
        "concurrency": { "enum": ["none", "optimistic"] },
        "mcpScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "events": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z-]+/contracts/events/v[0-9]+/.+\\.schema\\.json$" } },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "acceptanceCriterion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
          "description": { "type": "string" },
          "acceptanceCriterion": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "backend": { "type": "object", "properties": { "mcp": { "type": "object", "properties": { "exposed": { "const": true } }, "required": ["exposed"] } }, "required": ["mcp"] } }, "required": ["backend"] },
      "then": { "type": "object", "properties": { "backend": { "type": "object", "properties": { "mcp": { "type": "object", "properties": { "toolName": { "type": "string" } }, "required": ["toolName"] } } } } }
    }
  ]
}
