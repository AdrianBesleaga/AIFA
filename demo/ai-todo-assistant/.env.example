NODE_ENV=development
PORT=3000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=ai_todo_assistant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Browser OIDC settings are embedded by Vite at build time.
VITE_OIDC_ISSUER_URL=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPES=TaskRead TaskWrite TaskDelete AssistantPlanGenerate SettingsRead EventRead
# Production MCP calls use this OIDC access token. Never commit a real token.
MCP_ACCESS_TOKEN=
IDEMPOTENCY_LEASE_MS=300000
DEMO_TENANT_ID=local-tenant
DEMO_USER_ID=local-user
# Optional override; defaults to VITE_API_BASE_URL + /api/events.
VITE_EVENT_STREAM_URL=
